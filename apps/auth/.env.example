NODE_ENV=development
PORT=8081
BODY_LIMIT=100kb
ENABLE_DUPLICATE_JSON_KEY_VALIDATION=false
GRACEFUL_SHUTDOWN_TIMEOUT_MS=10000
# Optional: when unset, the service falls back to in-memory adapters
# (no Postgres / Valkey / AWS needed for local dev and tests).
DATABASE_URL=
VALKEY_URL=
SQS_QUEUE_URL=
AWS_REGION=ap-southeast-3
# Ed25519 account-JWT signing key (JWK JSON). When unset, an ephemeral
# keypair is generated at startup (tokens do not survive a restart).
AUTH_JWT_PRIVATE_KEY_JWK=
AUTH_JWT_KID=
AUTH_JWT_PUBLIC_KEYS_JWKS=
# OTP HMAC secret (ADR-0006). When unset, a random ephemeral secret is used.
OTP_SECRET=
