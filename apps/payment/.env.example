# payment-service — copy to .env and fill in (never commit .env)
NODE_ENV=development
PORT=8083
BODY_LIMIT=100kb
ENABLE_DUPLICATE_JSON_KEY_VALIDATION=false
GRACEFUL_SHUTDOWN_TIMEOUT_MS=10000

# Midtrans (sandbox by default; Server Key is backend-only)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SNAP_BASE_URL=https://app.sandbox.midtrans.com/snap
MIDTRANS_API_BASE_URL=https://api.sandbox.midtrans.com

# Store: leave DATABASE_URL empty for the in-memory store (tests / local).
# Set it to use Postgres (schema: src/infrastructure/store/schema.sql).
DATABASE_URL=
PAYMENT_STORE=memory

# Core-module (notifyPaymentResult target)
CORE_INTERNAL_URL=http://localhost:8082
CORE_SERVICE_CREDENTIAL=

# Webhook / Get Status / core-notify tuning
WEBHOOK_BODY_LIMIT_BYTES=65536
GET_STATUS_MAX_RETRIES=3
GET_STATUS_RETRY_BASE_MS=200
CORE_NOTIFY_MAX_RETRIES=3
CORE_NOTIFY_RETRY_BASE_MS=200
CORE_NOTIFY_TIMEOUT_MS=5000

# Payment redirect callbacks (wrapper page)
PAYMENT_FINISH_URL=
PAYMENT_UNFINISH_URL=
PAYMENT_ERROR_URL=
