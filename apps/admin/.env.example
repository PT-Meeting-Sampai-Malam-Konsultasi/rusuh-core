NODE_ENV=development
PORT=8086
BODY_LIMIT=100kb
ENABLE_DUPLICATE_JSON_KEY_VALIDATION=false
GRACEFUL_SHUTDOWN_TIMEOUT_MS=10000
# Postgres (unset = in-memory store, for tests/local dev without a database).
DATABASE_URL=
# Auth-module internal API: the admin guard reads accounts.role from here.
AUTH_URL=
SERVICE_KEY=
# Valkey: new categories get their stock counters seeded (unset = skipped).
VALKEY_URL=
# Event image uploads (presigned POST). ASSET_BASE_URL is the public CDN origin;
# image_url on events must start with it. Unset = upload endpoint returns 503.
ASSETS_BUCKET=
ASSET_BASE_URL=
AWS_REGION=ap-southeast-3
# Account-JWT public keys: a single JWK or {"keys": [...]} as JSON,
# or a JWKS URL published by auth-module. Unset = every token rejected.
AUTH_PUBLIC_KEY_JWK=
AUTH_JWKS_URL=
AUTH_AUDIENCE=
AUTH_ISSUER=
# Queue admin API (private port) for PATCH /v1/admin/events/:id/queue.
QUEUE_ADMIN_URL=
QUEUE_ADMIN_TOKEN=
# CORS origins (comma-separated). Unset/empty = default:
# https://rusuh-tiket.web.id,https://www.rusuh-tiket.web.id,http://localhost:3000,http://localhost:5173
CORS_ORIGINS=
