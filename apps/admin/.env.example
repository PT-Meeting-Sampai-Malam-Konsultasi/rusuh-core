NODE_ENV=development
PORT=8086
BODY_LIMIT=100kb
ENABLE_DUPLICATE_JSON_KEY_VALIDATION=false
GRACEFUL_SHUTDOWN_TIMEOUT_MS=10000
# Postgres (unset = in-memory store, for tests/local dev without a database).
DATABASE_URL=
# Account-JWT public keys: a single JWK or {"keys": [...]} as JSON,
# or a JWKS URL published by auth-module. Unset = every token rejected.
AUTH_PUBLIC_KEY_JWK=
AUTH_JWKS_URL=
AUTH_AUDIENCE=
AUTH_ISSUER=
# Queue admin API (private port) for PATCH /v1/admin/events/:id/queue.
QUEUE_ADMIN_URL=
QUEUE_ADMIN_TOKEN=
