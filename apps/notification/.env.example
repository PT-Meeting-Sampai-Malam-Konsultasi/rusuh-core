NODE_ENV=development
PORT=8084
BODY_LIMIT=100kb
ENABLE_DUPLICATE_JSON_KEY_VALIDATION=false
GRACEFUL_SHUTDOWN_TIMEOUT_MS=10000
AWS_REGION=ap-southeast-3
# SQS queues (LLD-04 §2: two queues, each with its own DLQ). Empty = worker disabled.
SQS_OTP_QUEUE_URL=
SQS_EMAIL_QUEUE_URL=
# SES sender (domain verified + DKIM). Midtrans built-in email stays disabled.
SES_FROM_EMAIL=noreply@rusuh-tiket.web.id
SES_MAX_SENDS_PER_SECOND=10
CONSUMER_CONCURRENCY=5
CONSUMER_MAX_BATCH=10
# Postgres (email_log dedup). Empty = in-memory store (degraded, non-durable).
DATABASE_URL=
S3_TICKET_BUCKET=
ADMIN_EMAIL=admin@rusuh-tiket.web.id
CLAIM_STALE_MINUTES=5
WORKER_ENABLED=true
# CORS allowed origins (comma-separated). Empty = default:
# https://rusuh-tiket.web.id,https://www.rusuh-tiket.web.id,http://localhost:3000,http://localhost:5173
CORS_ORIGINS=
