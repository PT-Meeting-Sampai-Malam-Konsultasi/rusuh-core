NODE_ENV=development
PORT=8082
BODY_LIMIT=100kb
ENABLE_DUPLICATE_JSON_KEY_VALIDATION=false
GRACEFUL_SHUTDOWN_TIMEOUT_MS=10000
# Durable + live stores. Unset = in-memory adapters (local dev, tests).
DATABASE_URL=
VALKEY_URL=
# Downstream services (internal). Unset PAYMENT_URL = stub mode.
DUKCAPIL_URL=http://localhost:18082
PAYMENT_URL=
SERVICE_KEY=
# SQS (ADR-0023). Unset = in-memory event bus.
AWS_REGION=ap-southeast-3
SQS_ADMISSION_QUEUE_URL=
SQS_EMPTY_SLOT_QUEUE_URL=
SQS_NOTIFICATION_QUEUE_URL=
# NIK keys (D24). Production: from KMS/Secrets Manager.
NIK_HMAC_KEY=
NIK_ENCRYPTION_KEY=
QR_HMAC_KEY=
# Account JWT verification (Q43): JWKS JSON (kid -> JWK). Unset = dev keypair.
AUTH_JWKS=
AUTH_AUDIENCE=rusuh-api
AUTH_ISSUER=rusuh-auth
# Fees (LLD-02 §8).
PLATFORM_FEE_IDR=30000
ADMIN_FEE_IDR=15000
PPN_RATE=0.11
TAX2_RATE=0
TAX2_BASE=0
TAX2_LABEL=Pajak Lainnya
# Background workers.
SWEEP_INTERVAL_MS=30000
DUKCAPIL_TIMEOUT_MS=2000
ADMISSION_TTL_MS=960000
