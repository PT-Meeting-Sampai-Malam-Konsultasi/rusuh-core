NODE_ENV=development
PORT=8085
BODY_LIMIT=100kb
ENABLE_DUPLICATE_JSON_KEY_VALIDATION=false
GRACEFUL_SHUTDOWN_TIMEOUT_MS=10000
# Postgres (tickets, bookings, events, accounts, audit_log). Required in production.
DATABASE_URL=postgres://rusuh:secret@localhost:5432/rusuh
# 32-byte NIK encryption key (base64). Dev/test stand-in for the KMS envelope (D24).
NIK_ENCRYPTION_KEY=
# Account-JWT public keys, JSON { kid: JWK }, published by auth-module (Q43).
AUTH_PUBLIC_KEYS_JSON=
AUTH_AUDIENCE=rusuh-api
AUTH_ISSUER=
# CORS origins, comma-separated. Default (when unset/empty):
# https://rusuh-tiket.web.id,https://www.rusuh-tiket.web.id,http://localhost:3000,http://localhost:5173
CORS_ORIGINS=
