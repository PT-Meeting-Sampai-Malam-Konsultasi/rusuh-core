{
  "name": "@rusuh/observability",
  "version": "0.1.0",
  "private": true,
  "description": "Structured JSON logging, correlation IDs, metrics hooks (CloudWatch/X-Ray).",
  "main": "src/index.js",
  "engines": {
    "node": ">=24.22.3 <25",
    "npm": ">=10"
  },
  "scripts": {
    "check": "npm run format:check && npm run lint && npm run test:coverage",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.9.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.0"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.301.2",
    "@opentelemetry/instrumentation-express": "^0.73.0",
    "@opentelemetry/instrumentation-http": "^0.301.2",
    "@opentelemetry/instrumentation-undici": "^0.35.1",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@opentelemetry/sdk-trace": "^3.1.1"
  }
}
