{
  "name": "@rusuh/auth",
  "version": "0.1.0",
  "private": true,
  "description": "Shared account-JWT verification (Ed25519) for all Node modules.",
  "main": "src/index.js",
  "engines": {
    "node": ">=24.22.3 <25",
    "npm": ">=10"
  },
  "scripts": {
    "check": "npm run format:check && npm run lint && npm run test:coverage",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.9.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.0"
  }
}
